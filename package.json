{
  "name": "algoarch-50lpa-platform",
  "version": "1.0.0",
  "description": "The complete 50LPA FAANG career guidance and preparation web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json",
    "db:import": "node tools/content/import.js --reset",
    "audit": "node tools/content/audit.js",
    "lint:comp": "node tools/content/comp-lint.js",
    "docs:widgets": "node tools/content/build-docs.js",
    "diagrams:sync": "node tools/content/sync-diagrams.js",
    "pathways": "node tools/content/build-pathways.js --write",
    "validate:curriculum": "node tools/content/validate-curriculum.js"
  },
  "keywords": [
    "dsa",
    "system-design",
    "ai-engineering",
    "faang",
    "career-guidance"
  ],
  "author": "Yashvardhan Vyas",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  }
}
